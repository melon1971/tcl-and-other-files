diff -ruN orig/scanistry-5.0-24-source/tests/test_5025.py src/scanistry-5.0-25-source/tests/test_5025.py
--- orig/scanistry-5.0-24-source/tests/test_5025.py	1970-01-01 00:00:00.000000000 +0000
