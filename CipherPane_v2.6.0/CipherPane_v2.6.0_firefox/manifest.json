{
  "manifest_version": 3,
  "name": "CipherPane Browser Security",
  "version": "2.6.0",
  "description": "Browser security: local phishing lookalike detection, malware/phishing reputation lists, ad/tracker blocking, download guard and HTTPS-first protection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "alarms",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'none'; worker-src 'self'; frame-src 'none'; style-src 'self'; img-src 'self' data:; connect-src https://curbengh.github.io https://malware-filter.gitlab.io https://cdn.jsdelivr.net https://raw.githubusercontent.com https://urlhaus-filter.pages.dev https://phishing-filter.pages.dev; base-uri 'none'; form-action 'none'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "malware_phishing_rules",
        "enabled": true,
        "path": "rules_malware.json"
      },
      {
        "id": "ads_trackers_rules",
        "enabled": true,
        "path": "rules_ads.json"
      }
    ]
  },
  "background": {
    "scripts": [
      "lists.js",
      "reputation.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CipherPane Security",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cipherpane-security@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
