+# a list and need-* settings are skipped; nothing is passed to eval as a
+# string. Returns "" on success or an error message.
+proc nb_reloadchansets {} {
+  global config
+  if {![file readable $config]} {
+    return "unable to read file $config"
+  }
+  if {[catch {open $config r} rfile]} {
+    return "unable to open $config: $rfile"
+  }
+  catch {
+    while {[gets $rfile line] >= 0} {
+      set line [string trim $line]
+      if {![string match "channel set *" $line]} {continue}
+      if {[catch {llength $line}] || [string first "\[" $line] != -1} {continue}
+      set chan [lindex $line 2] ; set settings [lrange $line 3 end]
+      if {![validchan $chan] || ![nb_chansetok $settings]} {continue}
+      catch {eval [list channel set $chan] $settings}
+    }
+  }
+  close $rfile
+  save
+  return ""
+}
