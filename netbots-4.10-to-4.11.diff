+# Remembers that we offered an update of type $file to $target ("*" or a
+# bot), so that "send" requests are only honoured for updates we initiated.
+proc nb_offer {target file} {
+  global nb_upinit
+  set nb_upinit([list [string tolower $target] $file]) [unixtime]
+  return
+}
+
+proc nb_offered {bot file} {
+  global nb_upinit
+  set now [unixtime]
+  foreach target [list * [string tolower $bot]] {
+    set key [list $target $file]
+    if {[info exists nb_upinit($key)] && $now - $nb_upinit($key) < 3600} {return 1}
+  }
+  return 0
+}
