+# Jumps to a server given as host[:port[:pass]] without ever passing the
+# string through eval (which allowed [command] injection).
+proc nb_jump {server} {
+  global default-port
+  set parts [split $server :]
+  set host [lindex $parts 0] ; set port [lindex $parts 1]
+  set pass [join [lrange $parts 2 end] :]
+  if {$host == "" || [regexp -- {[\s\x00-\x1f]} $server]} {
+    putlog "netbots: refusing to jump to invalid server '$server'"
+    return 0
+  }
+  if {$port == ""} {
+    if {[info exists default-port]} {
+      set port ${default-port}
+    } else {
+      set port 6667
+    }
+  }
+  if {![regexp -- {^\+?[0-9]{1,5}$} $port]} {
+    putlog "netbots: refusing to jump to '$server' (invalid port)"
+    return 0
+  }
+  if {$pass != ""} {
+    jump $host $port $pass
+  } else {
+    jump $host $port
+  }
+  return 1
+}
