+# only accepted for idxs that are real partyline CHAT sessions of owners, so a
+# netbot cannot write arbitrary text into another bot link or a user session.
+proc nb_putidx {idx text} {
+  if {![string is integer -strict $idx] || ![valididx $idx]} {return 0}
+  set ok 0
+  foreach dccuser [dcclist CHAT] {
