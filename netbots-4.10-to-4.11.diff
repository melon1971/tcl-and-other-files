+proc nb_cleanup {} {
+  global nb_ctrlidx nb_expect nb_gbdrop nb_gbtime nb_gbuffer nb_getfrom nb_getting nb_upinit
+  set now [unixtime]
+  foreach key [array names nb_gbtime] {
+    if {$now - $nb_gbtime($key) > 300} {
+      unset nb_gbtime($key)
+      if {[info exists nb_gbuffer($key)]} {
+        unset nb_gbuffer($key)
+      }
+    }
+  }
+  foreach key [array names nb_gbuffer] {
+    if {![info exists nb_gbtime($key)]} {
+      unset nb_gbuffer($key)
+    }
+  }
+  foreach key [array names nb_gbdrop] {
+    if {$now - $nb_gbdrop($key) > 300} {
+      unset nb_gbdrop($key)
+    }
+  }
+  foreach key [array names nb_upinit] {
+    if {$now - $nb_upinit($key) > 3600} {
+      unset nb_upinit($key)
+    }
+  }
+  foreach key [array names nb_expect] {
+    if {$nb_getting && [info exists nb_getfrom] && $nb_getfrom == $key} {continue}
+    if {$now - [lindex $nb_expect($key) 0] > 3600} {
+      unset nb_expect($key)
     }
