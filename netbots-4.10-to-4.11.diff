+# Clears per-bot state when a bot leaves the botnet.
+proc nb_disc {bot} {
+  global nb_expect nb_gbdrop nb_gbuffer nb_gbtime nb_getfrom nb_getting nb_sending
+  set stlbot [string tolower $bot]
+  foreach var {nb_gbuffer nb_gbtime nb_gbdrop} {
+    foreach key [array names $var "$stlbot,*"] {
+      unset ${var}($key)
+    }
+  }
+  if {[info exists nb_sending($stlbot)]} {
+    unset nb_sending($stlbot)
+    nb_killutimer "nb_timeout sending $bot *"
+    putlog "netbots: aborted file transfer to $bot (bot disconnected)."
+  }
+  if {$nb_getting && [info exists nb_getfrom] && $nb_getfrom == $stlbot} {
+    nb_killutimer "nb_timeout getting $bot *"
+    nb_killutimer "nb_wait $bot *"
+    nb_resetget
+    putlog "netbots: aborted file transfer from $bot (bot disconnected)."
+  }
+  if {[info exists nb_expect($stlbot)]} {
+    unset nb_expect($stlbot)
+  }
+  return 0
+}
