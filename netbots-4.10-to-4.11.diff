+# Returns the list of local files that make up an update type.
+proc nb_intfiles {file} {
+  global config motd nb_scripts nb_setscript telnet-banner
+  set banner ""
+  if {[info exists telnet-banner]} {
+    set banner ${telnet-banner}
+  }
+  switch -exact -- $file {
+    "config" {return [list $config]}
+    "motd" {return [list $motd]}
+    "telnet-banner" {return $banner}
+    "settings" {return [list $nb_setscript]}
+    "scripts" {return $nb_scripts}
+    "settings/scripts" {return [concat [list $nb_setscript] $nb_scripts]}
+    "changed" -
+    "everything" {return [concat [list $nb_setscript] $nb_scripts [list $config $motd] $banner]}
+  }
+  return $file
+}
+
+# Rejects empty names and any path containing a '..' component.
+proc nb_safepath {filename} {
+  if {$filename == "" || [regexp -- {[\x00-\x1f]} $filename]} {return 0}
+  foreach part [file split $filename] {
+    if {$part == ".."} {return 0}
+  }
+  return 1
+}
+
+proc nb_requestfiles {frombot file} {
+  global nb_expect
+  set files ""
+  set allowed ""
+  foreach intfile [nb_intfiles $file] {
+    if {![nb_safepath $intfile]} {
+      putlog "netbots: skipping unsafe file name '$intfile' in $file update."
+      continue
+    }
+    lappend files [list $intfile [nb_md5get $intfile]]
+    lappend allowed $intfile
+  }
+  set nb_expect([string tolower $frombot]) [list [unixtime] $file $allowed]
+  nb_sendcmd $frombot rnetupdate [list send $file $files]
+  return
+}
